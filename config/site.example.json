{
  "Gateway": {
    "ArchiveProvider": "Sqlite",
    "DatabasePath": "data/gateway.db",
    "MaxConcurrentPolls": 64,
    "QueueCapacity": 100000,
    "Controllers": [
      {
        "Id": "cj2-001", "Protocol": "FinsUdp", "Host": "192.168.10.11", "Port": 9600,
        "PollIntervalMs": 1000, "TimeoutMs": 1000,
        "SourceNetwork": 0, "SourceNode": 100, "SourceUnit": 0,
        "DestinationNetwork": 0, "DestinationNode": 11, "DestinationUnit": 0,
        "LowWordFirst": true,
        "Tags": [
          { "Id": "temperature", "Address": "D:100", "Type": "Int16", "Svid": 1001, "Scale": 0.1, "Unit": "C" },
          { "Id": "running", "Address": "CIO:10.3", "Type": "Bool", "Svid": 1002 }
        ]
      },
      {
        "Id": "nx-001", "Protocol": "EtherNetIp", "Host": "192.168.10.12", "Port": 44818,
        "PollIntervalMs": 1000, "TimeoutMs": 1000,
        "Tags": [
          { "Id": "temperature", "Address": "Temperature", "Type": "Float32", "Svid": 2001, "Unit": "C" },
          { "Id": "pressure", "Address": "Process.Pressure[0]", "Type": "Float32", "Svid": 2002, "Unit": "kPa" }
        ]
      }
    ],
    "Secs": {
      "Enabled": true, "Mode": "Passive", "Host": "127.0.0.1", "Port": 5000, "DeviceId": 0,
      "T3Seconds": 45, "T6Seconds": 5, "T7Seconds": 10, "T8Seconds": 5,
      "ReconnectSeconds": 5, "EventIntervalMs": 1000
    }
  }
}
